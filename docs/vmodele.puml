@startuml
title V-Modele 2TUP - Systeme de reservation de cinema

skinparam monochrome true
skinparam shadowing false
left to right direction

package "Branche Fonctionnelle" {
  [Vision] --> [UC]
  [UC] --> [Specs]
  [Specs] --> [AnalyseRisques]
}

package "Branche Technique" {
  [Outils] --> [Contraintes]
  [Contraintes] --> [Architecture]
}

package "Branche Milieu" {
  [Integration] --> [ImplEtTests]
}

[AnalyseRisques] -[hidden]-> [Contraintes]
[ImplEtTests] --> [Fusion]

note left of Vision : Livrables TP1 : Vision, UC
note right of Architecture : Livrable TP1 : Architecture
note bottom of ImplEtTests : Livrables TP1 : Tests, Revue croisee
note right of Fusion : Merge main : UC5-paiement + UC3-reserver-place
@enduml
